pipeline{
	agent any
	options {
        buildDiscarder(logRotator(
            numToKeepStr: '3',
            artifactNumToKeepStr: '5'
        ))
    }
	tools {
		jdk 'jdk21'
		nodejs 'node22'
	}
	environment {
		SCANNER_HOME = tool 'sonar-scanner'
		DPCHECK_HOME = tool 'DP-Check'
	}
	stages {
		stage('cleanworkspace') {
			steps { 
				cleanWs()
			}
		}
		stage('git checkout') {
			steps {
				git branch: 'main', url: 'https://github.com/itsurvey6-lab/Book-My-Show.git'
				sh 'ls -la'
				}
		}
		stage('SonarQube-code') {
			steps {
				withSonarQubeEnv(
				    installationName: 'sonar-server',
				    credentialsId: 'sonar-token') {
					sh '''
						pwd
						ls -la
						cd bookmyshow-app
						$SCANNER_HOME/bin/sonar-scanner \
						    -Dsonar.projectName=BMS \
							-Dsonar.projectKey=BMS \
							-Dsonar.sources=src
					'''
				}
			}
		}
		stage('Quality gate') {
			steps {
				script {
					waitForQualityGate( 
						abortPipeline: false, 
						credentialsId: 'sonar-token'
					)
				}
			}
		}
		stage('Install Dependencies') {
			steps {
				sh '''
					cd bookmyshow-app 
					ls -la
					npm ci
				'''
			}
		}
		stage('OWASP Dep Check') {
			steps {
			        dir('bookmyshow-app') {dependencyCheck(
			            additionalArguments: '--project "Book-My-Show" --scan . --out . --format HTML',
			            nvdCredentialsId: 'nvd-api-key', 
			            odcInstallation: 'DP-Check'
			            ) 
			    }
			}
		}
		stage('Trivy FS Scan') {
			steps {
				sh 'trivy fs ./bookmyshow-app > trivy.txt'
			}
		}
		stage('Docker Build') {
			steps {
				sh 'docker build -t itsurvey6/bms:latest ./bookmyshow-app'
			}
		}
		stage('Trivy image Scan') {
			steps {
				sh 'trivy image itsurvey6/bms:latest > trivy_image.txt'
			}
		}
		stage('Docker push') {
			steps {
			    withDockerRegistry(
			        credentialsId: 'Docker-hub', 
			        url: 'https://index.docker.io/v1/'
			        ){
				sh 'docker push itsurvey6/bms:latest'
			    }
			}
		}
		stage('Docker Deploy') {
			steps {
				sh '''
					docker stop bms || true
					docker rm bms || true
					docker run -d --name bms -p 3000:80 itsurvey6/bms:latest
					docker ps -a
					docker logs bms
				'''
			}
		}
		stage('Application test') {
			steps {
				sh 'curl http://192.168.1.5:3000'
			}
		}		
	}
	post {
    		always {
        		emailext(
            		subject: "BMS Pipeline - ${currentBuild.currentResult}",
            		body: "Build ${env.BUILD_NUMBER} completed.",
            		to: "itsurvey6@gmail.com",
            		attachmentsPattern: "trivy.txt,trivy_image.txt,bookmyshow-app/dependency-check-				report.html"
        		)
    		}
	}
}